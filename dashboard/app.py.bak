# ── Intent detector with fine-grained routing ──────────────────────────────
def detect_intent(query_text):
    q = query_text.lower()

    # Infrastructure-specific
    if any(w in q for w in ["infrastructure", "facility", "facilities", "building",
                              "toilet", "sanitation", "water", "electricity", "power"]):
        if any(w in q for w in ["compare", "vs", "versus", "difference", "with", "without", "impact"]):
            return "COMPARISON"
        return "INFRA_RANKING"

    # Trend / time-series
    if any(w in q for w in ["trend", "over time", "monthly", "daily", "timeline", "date"]):
        return "TREND"

    # Correlation / association
    if any(w in q for w in ["correlation", "correlated", "related", "relationship",
                              "associated", "marks vs attendance", "academic vs presence",
                              "attendance vs", "vs attendance"]):
        return "CORRELATION"

    # Generic comparison (non-infra)
    if any(w in q for w in ["compare", "difference", "versus", "vs"]):
        return "COMPARISON"

    # Anomaly / proxy
    if any(w in q for w in ["anomaly", "flag", "unusual", "proxy", "fake"]):
        return "ANOMALY"

    # MDM / meals
    if any(w in q for w in ["mdm", "meal", "mid-day", "midday", "food", "payment", "paid"]):
        return "MDM"

    # Academic / subject breakdown
    if any(w in q for w in ["subject", "marks", "test score", "grade", "academic",
                              "subject-wise", "which subject"]):
        return "BREAKDOWN"

    # Risk ranking (default numerical ranking)
    if any(w in q for w in ["highest", "lowest", "top", "rank", "bottom",
                              "riskiest", "district", "school", "level", "medium"]):
        # determine what metric to rank on
        if any(w in q for w in ["attendance", "presence", "absenteeism"]):
            return "RANK_ATTENDANCE"
        if any(w in q for w in ["academic", "score", "test", "marks"]):
            return "RANK_ACADEMIC"
        return "RANKING"

    return "RANKING"


