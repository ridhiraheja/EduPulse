        "Compare test scores for schools with and without electricity",
        "Which districts have the highest retention risk?",
        "Show attendance trend over time",
        "Which schools have high proxy attendance?",
        "Is attendance associated with academic performance?",
        "Which district has the lowest infrastructure availability?",
        "Show average test score by subject",
        "Show MDM payment status by district",
        "Which schools have the highest academic risk?",
    ]

    chip_cols = st.columns(3)
    for idx, prompt_text in enumerate(sample_prompts):
        with chip_cols[idx % 3]:
            if st.button(f"💡 {prompt_text}", key=f"chip_{idx}", use_container_width=True):
                st.session_state["ai_input_text"] = prompt_text

    ai_query_input = st.text_input(
        "Enter natural language question:",
        value=st.session_state.get("ai_input_text", ""),
        placeholder="e.g. Which district has the lowest infrastructure availability?"
    )

    if ai_query_input:
        resolved_intent = detect_intent(ai_query_input)
        meta = INTENT_META.get(resolved_intent, INTENT_META["RANKING"])

        # Audit trace
        st.markdown(
            f"""
            <div style="background: rgba(40,8,50,0.85); border: 1px solid rgba(180,80,160,0.3); border-radius: 12px; padding: 14px 20px; margin-top: 15px; margin-bottom: 20px;">
                <div style="font-size: 11px; font-weight: 700; color: #f472b6; text-transform: uppercase; letter-spacing: 0.8px;">AGENT REASONING & INTENT AUDIT TRACE</div>
                <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 15px; margin-top: 8px; font-size: 12px; color: #e8d5ff;">
                    <div>🎯 <strong>Intent:</strong> {resolved_intent}</div>
                    <div>📂 <strong>Dataset:</strong> {meta['dataset']}</div>
                    <div>📐 <strong>Metric:</strong> {meta['metric']}</div>
                    <div>📊 <strong>Visualization:</strong> {meta['chart']}</div>
                    <div>⚡ <strong>Scope:</strong> {len(filtered_df)} schools</div>
                </div>
            </div>
            """,
            unsafe_allow_html=True
        )

        # ── COMPARISON (electricity vs test score) ──────────────────────────
        if resolved_intent == "COMPARISON":
            elec_yes = filtered_df[filtered_df["electricity_available"] >= 100]
            elec_no  = filtered_df[filtered_df["electricity_available"] < 100]
            score_yes = elec_yes["average_test_score"].mean()
            score_no  = elec_no["average_test_score"].mean()
            diff = score_yes - score_no

            c_q1, c_q2 = st.columns([1, 1.3])
            with c_q1:
                st.markdown(
                    f"""
                    <div style="background:rgba(40,8,50,0.8); border:1px solid rgba(244,114,182,0.3); padding:18px; border-radius:14px;">
                        <div style="font-size:11px; color:#c084fc; font-weight:700;">KEY EVIDENCE</div>
                        <div style="margin-top:8px;">
                            <span style="font-size:13px; color:#e8d5ff;">⚡ With Electricity:</span><br/>
                            <strong style="font-size:24px; color:#f472b6;">{score_yes:.2f}%</strong> avg test score ({len(elec_yes)} schools)
                        </div>
                        <div style="margin-top:10px;">
                            <span style="font-size:13px; color:#e8d5ff;">🔌 Without Electricity:</span><br/>
                            <strong style="font-size:24px; color:#fb923c;">{score_no:.2f}%</strong> avg test score ({len(elec_no)} schools)
                        </div>
                        <hr style="border-color:rgba(200,80,160,0.2); margin:10px 0;"/>
                        <div style="font-size:13px; color:#a78bfa; font-weight:700;">
                            Difference: {diff:+.2f} percentage points
                        </div>
                    </div>
                    """,
                    unsafe_allow_html=True
                )
            with c_q2:
                cmp_df = pd.DataFrame({
                    "Electricity Readiness": ["With Electricity", "Without Electricity"],
                    "Average Test Score (%)": [score_yes, score_no]
                })
                fig_q1 = px.bar(cmp_df, x="Electricity Readiness", y="Average Test Score (%)",
                                color="Electricity Readiness", text_auto=".2f",
                                color_discrete_map={"With Electricity": "#f472b6", "Without Electricity": "#fb923c"})
                fig_q1.update_layout(**PLOTLY_LAYOUT, height=300, showlegend=False)
                st.plotly_chart(fig_q1, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Business Insight:</strong> Schools with functional electricity averaged <strong>{score_yes:.2f}%</strong> vs <strong>{score_no:.2f}%</strong> for those without — a gap of <strong>{diff:+.2f} pp</strong>.<br/>
                    <strong>Limitation:</strong> Association only; causality is not established.
                </div>""",
                unsafe_allow_html=True
            )

        # ── INFRA_RANKING — infrastructure availability by district ─────────
        elif resolved_intent == "INFRA_RANKING":
            infra_agg = filtered_df.groupby("district").agg(
                avg_facilities=("average_facility_count", "mean"),
                avg_infra_risk=("infrastructure_risk", "mean"),
                school_count=("school_id", "count")
            ).reset_index().sort_values("avg_facilities", ascending=True)

            worst_dist = infra_agg.iloc[0]
            best_dist  = infra_agg.iloc[-1]

            c_i1, c_i2 = st.columns([1, 1.5])
            with c_i1:
                st.markdown(
                    f"""
                    <div style="background:rgba(40,8,50,0.8); border:1px solid rgba(244,114,182,0.3); padding:18px; border-radius:14px;">
                        <div style="font-size:11px; color:#c084fc; font-weight:700;">INFRASTRUCTURE SUMMARY</div>
                        <div style="margin-top:12px;">
                            <div style="font-size:12px; color:#fce7f3;">🔴 Lowest availability:</div>
                            <div style="font-size:20px; font-weight:800; color:#f472b6;">{worst_dist['district']}</div>
                            <div style="font-size:13px; color:#fb923c;">{worst_dist['avg_facilities']:.2f}/5.0 avg facilities</div>
                            <div style="font-size:11px; color:#9d6baf;">Infra Risk: {worst_dist['avg_infra_risk']:.1f}</div>
                        </div>
                        <hr style="border-color:rgba(200,80,160,0.2); margin:10px 0;"/>
                        <div style="margin-top:8px;">
                            <div style="font-size:12px; color:#fce7f3;">🟢 Best availability:</div>
                            <div style="font-size:20px; font-weight:800; color:#a78bfa;">{best_dist['district']}</div>
                            <div style="font-size:13px; color:#c084fc;">{best_dist['avg_facilities']:.2f}/5.0 avg facilities</div>
                        </div>
                    </div>
                    """,
                    unsafe_allow_html=True
                )
            with c_i2:
                fig_infra = px.bar(
                    infra_agg, x="avg_facilities", y="district", orientation="h",
                    text_auto=".2f",
                    title="Average Facility Count by District (lower = worse coverage)",
                    color="avg_facilities",
                    color_continuous_scale=["#f43f5e", "#fb923c", "#fbbf24", "#a78bfa", "#c084fc"]
                )
                fig_infra.update_layout(**PLOTLY_LAYOUT, height=340, coloraxis_showscale=False)
                st.plotly_chart(fig_infra, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Answer:</strong> District <strong>{worst_dist['district']}</strong> has the lowest infrastructure availability with an average of <strong>{worst_dist['avg_facilities']:.2f}/5.0</strong> core facilities per school.<br/>
                    <strong>Best covered:</strong> <strong>{best_dist['district']}</strong> at <strong>{best_dist['avg_facilities']:.2f}/5.0</strong>.<br/>
                    <strong>Methodology:</strong> Average of functional facility count (0–5 scale) across all schools in each district, from clean infrastructure records.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools across {len(infra_agg)} districts.
                </div>""",
                unsafe_allow_html=True
            )

        # ── TREND — attendance over time ────────────────────────────────────
        elif resolved_intent == "TREND":
            filtered_school_ids = set(filtered_df["school_id"])
            att_sub = df_att[df_att["school_id"].isin(filtered_school_ids)].dropna(subset=["date"])

            if len(att_sub) > 0:
                trend_df = att_sub.groupby("date")["attendance_rate"].mean().reset_index().sort_values("date")
                overall_mean = trend_df["attendance_rate"].mean()
                max_row = trend_df.loc[trend_df["attendance_rate"].idxmax()]
                min_row = trend_df.loc[trend_df["attendance_rate"].idxmin()]

                fig_trend = px.line(trend_df, x="date", y="attendance_rate",
                                    title="Attendance Rate Over Time",
                                    labels={"date": "Reporting Date", "attendance_rate": "Avg Attendance (%)"},
                                    color_discrete_sequence=["#f472b6"])
                fig_trend.update_layout(**PLOTLY_LAYOUT, height=340)
                st.plotly_chart(fig_trend, use_container_width=True)

                st.markdown(
                    f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                        <strong>💡 Business Insight:</strong> Attendance evaluated across <strong>{len(trend_df)}</strong> reporting dates (mean: <strong>{overall_mean:.1f}%</strong>).<br/>
                        Peak: <strong>{max_row['date'].strftime('%Y-%m-%d')}</strong> ({max_row['attendance_rate']:.1f}%) | Lowest: <strong>{min_row['date'].strftime('%Y-%m-%d')}</strong> ({min_row['attendance_rate']:.1f}%).<br/>
                        <strong>Data Coverage:</strong> {len(att_sub):,} attendance records.
                    </div>""",
                    unsafe_allow_html=True
                )

        # ── CORRELATION — attendance vs academic ────────────────────────────
        elif resolved_intent == "CORRELATION":
            r_val = filtered_df["average_attendance_rate"].corr(filtered_df["average_test_score"])

            c_corr1, c_corr2 = st.columns([1, 1.3])
            with c_corr1:
                st.markdown(
                    f"""
                    <div style="background:rgba(40,8,50,0.8); border:1px solid rgba(168,85,247,0.3); padding:18px; border-radius:14px;">
                        <div style="font-size:11px; color:#c084fc; font-weight:700;">PEARSON CORRELATION</div>
                        <div style="font-size:32px; font-weight:800; color:#f472b6; margin:6px 0;">r = {r_val:.3f}</div>
                        <div style="font-size:12px; color:#e8d5ff;">
                            ● Linear Relation: <strong>Essentially Zero</strong><br/>
                            ● Evaluated Scope: <strong>{len(filtered_df)} Schools</strong>
                        </div>
                    </div>
                    """,
                    unsafe_allow_html=True
                )
            with c_corr2:
                fig_corr = px.scatter(
                    filtered_df, x="average_attendance_rate", y="average_test_score",
                    trendline="ols", trendline_color_override="#f472b6",
                    color="school_type",
                    color_discrete_sequence=["#c084fc", "#fb923c", "#f472b6", "#a78bfa"]
                )
                fig_corr.update_layout(**PLOTLY_LAYOUT, height=300)
                st.plotly_chart(fig_corr, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Business Insight:</strong> Pearson r = <strong>{r_val:.3f}</strong> — no meaningful linear relationship between attendance rate and test score at school level.<br/>
                    <strong>Limitation:</strong> Bivariate linear association only; unmeasured factors not evaluated.
                </div>""",
                unsafe_allow_html=True
            )

        # ── ANOMALY — proxy attendance flags ────────────────────────────────
        elif resolved_intent == "ANOMALY":
            proxy_df = filtered_df[filtered_df["proxy_attendance_rate"] > 5.0].sort_values(
                "proxy_attendance_rate", ascending=False
            )[["school_name", "district", "block", "proxy_attendance_rate", "average_attendance_rate"]].head(20)

            st.markdown(f"### ⚠️ {len(proxy_df)} Schools with Proxy Attendance Rate > 5%")
            st.dataframe(
                proxy_df.rename(columns={
                    "school_name": "School", "district": "District", "block": "Block",
                    "proxy_attendance_rate": "Proxy Rate (%)", "average_attendance_rate": "Avg Attendance (%)"
                }),
                use_container_width=True, hide_index=True
            )
            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Answer:</strong> <strong>{len(proxy_df)}</strong> schools exceed the 5% proxy attendance threshold, indicating possible inflated attendance reporting that warrants field inspection.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools evaluated.
                </div>""",
                unsafe_allow_html=True
            )

        # ── MDM — payment status by district ────────────────────────────────
        elif resolved_intent == "MDM":
            mdm_agg = filtered_df.groupby("district").agg(
                avg_paid_pct=("paid_percentage", "mean"),
                school_count=("school_id", "count")
            ).reset_index().sort_values("avg_paid_pct", ascending=True)

            worst_mdm = mdm_agg.iloc[0]
            fig_mdm = px.bar(mdm_agg, x="avg_paid_pct", y="district", orientation="h",
                             text_auto=".1f",
                             title="MDM Payment Clearance Rate by District (%)",
                             color="avg_paid_pct",
                             color_continuous_scale=["#f43f5e", "#fb923c", "#fbbf24", "#a78bfa"])
            fig_mdm.update_layout(**PLOTLY_LAYOUT, height=340, coloraxis_showscale=False)
            st.plotly_chart(fig_mdm, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Answer:</strong> District <strong>{worst_mdm['district']}</strong> has the lowest MDM payment clearance at <strong>{worst_mdm['avg_paid_pct']:.1f}%</strong>, indicating elevated risk of supply chain disruption for mid-day meal operations.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools across {len(mdm_agg)} districts.
                </div>""",
                unsafe_allow_html=True
            )

        # ── BREAKDOWN — test scores by subject ──────────────────────────────
        elif resolved_intent == "BREAKDOWN":
            filtered_school_ids = set(filtered_df["school_id"])
            test_sub = df_tests[df_tests["school_id"].isin(filtered_school_ids)].copy()
            test_sub["score_pct"] = pd.to_numeric(test_sub.get("score_percentage", test_sub.get("marks", None)), errors="coerce")

            if "subject" in test_sub.columns and test_sub["score_pct"].notna().any():
                subj_agg = test_sub.groupby("subject")["score_pct"].mean().reset_index().sort_values("score_pct", ascending=False)
                fig_subj = px.bar(subj_agg, x="subject", y="score_pct", text_auto=".1f",
                                  title="Average Test Score by Subject",
                                  color="score_pct",
                                  color_continuous_scale=["#f43f5e", "#fb923c", "#c084fc", "#a78bfa"])
                fig_subj.update_layout(**PLOTLY_LAYOUT, height=340, coloraxis_showscale=False)
                st.plotly_chart(fig_subj, use_container_width=True)
            else:
                st.info("Subject-level breakdown not available in current dataset columns.")

        # ── RANK_ATTENDANCE — attendance ranking by district ─────────────────
        elif resolved_intent == "RANK_ATTENDANCE":
            att_agg = filtered_df.groupby("district").agg(
                avg_att=("average_attendance_rate", "mean"),
                school_count=("school_id", "count")
            ).reset_index().sort_values("avg_att", ascending=True)

            worst = att_agg.iloc[0]
            fig_att = px.bar(att_agg, x="avg_att", y="district", orientation="h",
                             text_auto=".1f",
                             title="Average Attendance Rate by District (lower = worse)",
                             color="avg_att",
                             color_continuous_scale=["#f43f5e", "#fb923c", "#fbbf24", "#a78bfa"])
            fig_att.update_layout(**PLOTLY_LAYOUT, height=340, coloraxis_showscale=False)
            st.plotly_chart(fig_att, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Answer:</strong> District <strong>{worst['district']}</strong> has the lowest average attendance at <strong>{worst['avg_att']:.1f}%</strong>.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools across {len(att_agg)} districts.
                </div>""",
                unsafe_allow_html=True
            )

        # ── RANK_ACADEMIC — academic score ranking ───────────────────────────
        elif resolved_intent == "RANK_ACADEMIC":
            acad_agg = filtered_df.groupby("district").agg(
                avg_score=("average_test_score", "mean"),
                school_count=("school_id", "count")
            ).reset_index().sort_values("avg_score", ascending=True)

            worst = acad_agg.iloc[0]
            fig_acad = px.bar(acad_agg, x="avg_score", y="district", orientation="h",
                              text_auto=".1f",
                              title="Average Test Score by District (lower = worse academic performance)",
                              color="avg_score",
                              color_continuous_scale=["#f43f5e", "#fb923c", "#fbbf24", "#a78bfa"])
            fig_acad.update_layout(**PLOTLY_LAYOUT, height=340, coloraxis_showscale=False)
            st.plotly_chart(fig_acad, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Answer:</strong> District <strong>{worst['district']}</strong> has the lowest academic performance at <strong>{worst['avg_score']:.1f}%</strong>.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools across {len(acad_agg)} districts.
                </div>""",
                unsafe_allow_html=True
            )

        # ── RANKING (default) — retention risk ranking ───────────────────────
        else:
            dist_risk_agg = filtered_df.groupby("district").agg(
                avg_risk=("retention_risk_indicator", "mean"),
                avg_att_risk=("attendance_risk", "mean"),
                avg_score_risk=("score_risk", "mean"),
                avg_infra_risk=("infrastructure_risk", "mean")
            ).reset_index().sort_values("avg_risk", ascending=False)

            top_dist = dist_risk_agg.iloc[0]

            fig_qd = px.bar(dist_risk_agg, x="avg_risk", y="district", orientation="h",
                            text_auto=".2f", title="District Retention Risk Ranking",
                            color="avg_risk",
                            color_continuous_scale=["#a78bfa", "#fb923c", "#f43f5e"])
            fig_qd.update_layout(**PLOTLY_LAYOUT, height=320, coloraxis_showscale=False)
            st.plotly_chart(fig_qd, use_container_width=True)

            st.markdown(
                f"""<div style="background:rgba(190,24,93,0.12); border:1px solid rgba(244,114,182,0.3); padding:16px; border-radius:12px; margin-top:15px;">
                    <strong>💡 Business Insight:</strong> District <strong>{top_dist['district']}</strong> has the highest average retention risk index at <strong>{top_dist['avg_risk']:.2f}</strong>.<br/>
                    <strong>Methodology:</strong> Mean retention risk indicator aggregated by district.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools across {len(dist_risk_agg)} districts.<br/>
                    <strong>Limitation:</strong> Composite analytical prioritization index — not a measured dropout probability.
                </div>""",
                unsafe_allow_html=True
            )

        # Follow-up suggestion chips
        st.markdown("<div style='font-size:12px; font-weight:700; color:#c084fc; margin-top:15px; margin-bottom:8px;'>SUGGESTED FOLLOW-UP QUESTIONS:</div>", unsafe_allow_html=True)
        fu_col1, fu_col2, fu_col3 = st.columns(3)
        with fu_col1:
            if st.button("🔍 Which district has the highest risk?", key="fu1", use_container_width=True):
                st.session_state["ai_input_text"] = "Which districts have the highest retention risk?"
                st.rerun()
        with fu_col2:
            if st.button("📊 Show attendance trend over time", key="fu2", use_container_width=True):
                st.session_state["ai_input_text"] = "Show attendance trend over time"
                st.rerun()
        with fu_col3:
            if st.button("⚠️ Which schools have high proxy attendance?", key="fu3", use_container_width=True):
                st.session_state["ai_input_text"] = "Which schools have high proxy attendance?"
                st.rerun()

st.markdown("<hr style='border-color: rgba(200,80,160,0.15); margin-top:30px;'/>", unsafe_allow_html=True)

if st.session_state["show_ai_agent"]:
    st.markdown(
        """
        <div style="background: linear-gradient(135deg, rgba(30, 27, 75, 0.9), rgba(15, 23, 42, 0.95)); border: 1px solid rgba(139, 92, 246, 0.4); border-radius: 18px; padding: 24px; margin-bottom: 25px; box-shadow: 0 15px 40px rgba(139, 92, 246, 0.15);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 22px; font-weight: 800; color: #c084fc; display: flex; align-items: center; gap: 10px;">
                    <span>✦ Ask EduPulse AI Workspace</span>
                    <span style="font-size: 11px; background: rgba(139, 92, 246, 0.3); padding: 3px 10px; border-radius: 9999px; color: #e9d5ff; font-weight: 600;">Agentic Query Engine</span>
                </div>
            </div>
            <div style="font-size: 13px; color: #cbd5e1; margin-top: 4px;">
                Ask a natural language question about attendance, academics, infrastructure, Mid-Day Meals, or retention risk.
            </div>
        </div>
        """,
        unsafe_allow_html=True
    )
    
    col_back, _ = st.columns([1, 4])
    with col_back:
        if st.button("← Back to Dashboard", use_container_width=True):
            st.session_state["show_ai_agent"] = False
            st.rerun()

    # Clickable Sample Prompt Chips
    st.markdown("<div style='font-size: 12px; font-weight: 700; color: #94a3b8; margin-bottom: 8px;'>EXAMPLE PROMPTS (CLICK TO RUN):</div>", unsafe_allow_html=True)
    
    sample_prompts = [
        "Compare test scores for schools with and without electricity",
        "Which districts have the highest retention risk?",
        "Show attendance trend over time",
        "Which schools have high proxy attendance?",
        "Is attendance associated with academic performance?",
        "Which district has the lowest infrastructure availability?",
        "Show average test score by subject",
        "Show average attendance by school type",
        "Which schools have the highest academic risk?",
        "Which schools have the highest infrastructure risk?",
        "Show MDM payment status by district",
        "Which districts have the highest proxy attendance?",
        "Show the distribution of retention risk",
        "Compare average attendance between high-risk and low-risk schools",
        "Which schools have multiple risk drivers above threshold?"
    ]

    chip_cols = st.columns(3)
    for idx, prompt_text in enumerate(sample_prompts[:9]):
        with chip_cols[idx % 3]:
            if st.button(f"💡 {prompt_text}", key=f"chip_{idx}", use_container_width=True):
                st.session_state["ai_input_text"] = prompt_text

    ai_query_input = st.text_input("Enter natural language question:", value=st.session_state.get("ai_input_text", ""), placeholder="e.g. Compare test scores by electricity availability")

    if ai_query_input:
        resolved_intent = detect_intent(ai_query_input)
        
        # Dataset Registry & Execution Trace
        intent_metadata = {
            "COMPARISON": {"dataset": "School Master & Infrastructure", "metric": "average_test_score", "dimension": "electricity_available", "chart": "Grouped Bar Chart"},
            "TREND": {"dataset": "Clean Attendance Records", "metric": "attendance_rate", "dimension": "date", "chart": "Time-Series Line Chart"},
            "RANKING": {"dataset": "School Master Analytics", "metric": "retention_risk_indicator", "dimension": "district", "chart": "Horizontal Bar Chart"},
            "CORRELATION": {"dataset": "School Master Analytics", "metric": "attendance_rate vs test_score", "dimension": "school_id", "chart": "Bivariate Scatter Plot"},
            "ANOMALY": {"dataset": "Clean Attendance & Master", "metric": "proxy_attendance_rate (>5%)", "dimension": "school_id", "chart": "Ranked Alert Table"},
            "BREAKDOWN": {"dataset": "Clean Test Scores", "metric": "score_percentage", "dimension": "subject", "chart": "Bar Chart"}
        }
        meta = intent_metadata.get(resolved_intent, intent_metadata["RANKING"])

        # Display Concise Audit Trace
        st.markdown(
            f"""
            <div style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 12px; padding: 14px 20px; margin-top: 15px; margin-bottom: 20px;">
                <div style="font-size: 11px; font-weight: 700; color: #c084fc; text-transform: uppercase; letter-spacing: 0.8px;">AGENT REASONING & INTENT AUDIT TRACE</div>
                <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 15px; margin-top: 8px; font-size: 12px; color: #e2e8f0;">
                    <div>🎯 <strong>Intent:</strong> {resolved_intent}</div>
                    <div>📂 <strong>Dataset:</strong> {meta['dataset']}</div>
                    <div>📐 <strong>Metric:</strong> {meta['metric']}</div>
                    <div>📊 <strong>Visualization Selected:</strong> {meta['chart']}</div>
                    <div>⚡ <strong>Filter Status:</strong> Respecting current global selection ({len(filtered_df)} schools)</div>
                </div>
            </div>
            """,
            unsafe_allow_html=True
        )

        # RENDER AI RESPONSE FORMAT
        if resolved_intent == "COMPARISON":
            elec_yes = filtered_df[filtered_df["electricity_available"] >= 100]
            elec_no = filtered_df[filtered_df["electricity_available"] < 100]

            score_yes = elec_yes["average_test_score"].mean()
            score_no = elec_no["average_test_score"].mean()
            diff = score_yes - score_no

            c_q1, c_q2 = st.columns([1, 1.3])
            with c_q1:
                st.markdown(
                    f"""
                    <div style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(56, 189, 248, 0.3); padding: 18px; border-radius: 14px;">
                        <div style="font-size:11px; color:#94a3b8; font-weight:700;">KEY EVIDENCE</div>
                        <div style="margin-top:8px;">
                            <span style="font-size:13px; color:#e2e8f0;">⚡ With Electricity:</span><br/>
                            <strong style="font-size:24px; color:#38bdf8;">{score_yes:.2f}%</strong> avg test score ({len(elec_yes)} schools)
                        </div>
                        <div style="margin-top:10px;">
                            <span style="font-size:13px; color:#e2e8f0;">🔌 Without Electricity:</span><br/>
                            <strong style="font-size:24px; color:#f43f5e;">{score_no:.2f}%</strong> avg test score ({len(elec_no)} schools)
                        </div>
                        <hr style="border-color:rgba(255,255,255,0.1); margin:10px 0;"/>
                        <div style="font-size:13px; color:#34d399; font-weight:700;">
                            Measured Difference: {diff:+.2f} percentage points
                        </div>
                    </div>
                    """,
                    unsafe_allow_html=True
                )
            with c_q2:
                cmp_df = pd.DataFrame({
                    "Electricity Readiness": ["With Electricity", "Without Electricity"],
                    "Average Test Score (%)": [score_yes, score_no]
                })
                fig_q1 = px.bar(
                    cmp_df,
                    x="Electricity Readiness",
                    y="Average Test Score (%)",
                    color="Electricity Readiness",
                    text_auto=".2f",
                    color_discrete_map={"With Electricity": "#38bdf8", "Without Electricity": "#f43f5e"}
                )
                fig_q1.update_layout(**PLOTLY_LAYOUT)
                fig_q1.update_layout(height=300, showlegend=False)
                st.plotly_chart(fig_q1, use_container_width=True)

            st.markdown(
                f"""
                <div style="background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); padding: 16px; border-radius: 12px; margin-top: 15px;">
                    <strong>💡 Business Insight:</strong> Schools with functional electricity recorded an average test score of <strong>{score_yes:.2f}%</strong>, compared with <strong>{score_no:.2f}%</strong> for schools without functional electricity, a difference of <strong>{diff:+.2f} percentage points</strong>.<br/>
                    <strong>Methodology:</strong> Mean percentage-compatible test score aggregated at school level.<br/>
                    <strong>Data Coverage:</strong> {len(elec_yes)} schools with electricity; {len(elec_no)} schools without electricity.<br/>
                    <strong>Limitation Disclaimer:</strong> Association only; causality is not established.
                </div>
                """,
                unsafe_allow_html=True
            )

        elif resolved_intent == "TREND":
            filtered_school_ids = set(filtered_df["school_id"])
            att_sub = df_att[df_att["school_id"].isin(filtered_school_ids)].dropna(subset=["date"])

            if len(att_sub) > 0:
                trend_df = att_sub.groupby("date")["attendance_rate"].mean().reset_index().sort_values("date")
                overall_mean = trend_df["attendance_rate"].mean()
                max_date_row = trend_df.loc[trend_df["attendance_rate"].idxmax()]
                min_date_row = trend_df.loc[trend_df["attendance_rate"].idxmin()]

                fig_trend = px.line(
                    trend_df,
                    x="date",
                    y="attendance_rate",
                    title="Attendance Rate Over Time",
                    labels={"date": "Reporting Date", "attendance_rate": "Avg Attendance (%)"},
                    color_discrete_sequence=["#38bdf8"]
                )
                fig_trend.update_layout(**PLOTLY_LAYOUT)
                fig_trend.update_layout(height=340)
                st.plotly_chart(fig_trend, use_container_width=True)

                st.markdown(
                    f"""
                    <div style="background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); padding: 16px; border-radius: 12px; margin-top: 15px;">
                        <strong>💡 Business Insight:</strong> Attendance was evaluated across <strong>{len(trend_df)}</strong> distinct reporting dates (mean: <strong>{overall_mean:.1f}%</strong>). Peak attendance occurred on <strong>{max_date_row['date'].strftime('%Y-%m-%d')}</strong> ({max_date_row['attendance_rate']:.1f}%), while lowest presence was observed on <strong>{min_date_row['date'].strftime('%Y-%m-%d')}</strong> ({min_date_row['attendance_rate']:.1f}%).<br/>
                        <strong>Methodology:</strong> Daily mean attendance calculated from clean attendance logs.<br/>
                        <strong>Data Coverage:</strong> {len(att_sub):,} line-level attendance records.<br/>
                        <strong>Limitation Disclaimer:</strong> Reflects administrative attendance logs; subject to reporting anomalies.
                    </div>
                    """,
                    unsafe_allow_html=True
                )

        elif resolved_intent == "CORRELATION":
            r_val = filtered_df["average_attendance_rate"].corr(filtered_df["average_test_score"])

            c_corr1, c_corr2 = st.columns([1, 1.3])
            with c_corr1:
                st.markdown(
                    f"""
                    <div style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(168, 85, 247, 0.3); padding: 18px; border-radius: 14px;">
                        <div style="font-size:11px; color:#94a3b8; font-weight:700;">PEARSON CORRELATION</div>
                        <div style="font-size:32px; font-weight:800; color:#c084fc; margin:6px 0;">r = {r_val:.3f}</div>
                        <div style="font-size:12px; color:#e2e8f0;">
                            ● Linear Relation: <strong>Essentially Zero</strong><br/>
                            ● Evaluated Scope: <strong>{len(filtered_df)} Schools</strong>
                        </div>
                    </div>
                    """,
                    unsafe_allow_html=True
                )
            with c_corr2:
                fig_corr = px.scatter(
                    filtered_df,
                    x="average_attendance_rate",
                    y="average_test_score",
                    trendline="ols",
                    trendline_color_override="#f472b6",
                    color="school_type",
                    color_discrete_sequence=["#c084fc", "#fb923c", "#f472b6", "#a78bfa"]
                )
                fig_corr.update_layout(**PLOTLY_LAYOUT)
                fig_corr.update_layout(height=300)
                st.plotly_chart(fig_corr, use_container_width=True)

            st.markdown(
                f"""
                <div style="background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); padding: 16px; border-radius: 12px; margin-top: 15px;">
                    <strong>💡 Business Insight:</strong> The Pearson correlation coefficient is <strong>r = {r_val:.3f}</strong>. The available school-level data shows essentially no linear relationship between average attendance rate and converted test score.<br/>
                    <strong>Methodology:</strong> Bivariate correlation between school average attendance % and score %.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools.<br/>
                    <strong>Limitation Disclaimer:</strong> Evaluates bivariate linear association only; unmeasured factors are not evaluated.
                </div>
                """,
                unsafe_allow_html=True
            )

        else:
            # RANKING / DEFAULT
            dist_risk_agg = filtered_df.groupby("district").agg(
                avg_risk=("retention_risk_indicator", "mean"),
                avg_att_risk=("attendance_risk", "mean"),
                avg_score_risk=("score_risk", "mean"),
                avg_infra_risk=("infrastructure_risk", "mean")
            ).reset_index().sort_values("avg_risk", ascending=False)

            top_dist = dist_risk_agg.iloc[0]

            fig_qd = px.bar(
                dist_risk_agg,
                x="avg_risk",
                y="district",
                orientation="h",
                text_auto=".2f",
                title="District Retention Risk Ranking",
                color="avg_risk",
                color_continuous_scale=["#34d399", "#fbbf24", "#f43f5e"]
            )
            fig_qd.update_layout(**PLOTLY_LAYOUT)
            fig_qd.update_layout(height=320, coloraxis_showscale=False)
            st.plotly_chart(fig_qd, use_container_width=True)

            st.markdown(
                f"""
                <div style="background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); padding: 16px; border-radius: 12px; margin-top: 15px;">
                    <strong>💡 Business Insight:</strong> District <strong>{top_dist['district']}</strong> records the highest average retention risk index at <strong>{top_dist['avg_risk']:.2f}</strong>.<br/>
                    <strong>Methodology:</strong> Mean retention risk indicator aggregated by district.<br/>
                    <strong>Data Coverage:</strong> {len(filtered_df)} schools across {len(dist_risk_agg)} districts.<br/>
                    <strong>Limitation Disclaimer:</strong> Composite analytical prioritization index — not a measured dropout probability.
                </div>
                """,
                unsafe_allow_html=True
            )

        # Contextual Follow-Up Buttons (3 chips)
        st.markdown("<div style='font-size:12px; font-weight:700; color:#94a3b8; margin-top:15px; margin-bottom:8px;'>SUGGESTED FOLLOW-UP QUESTIONS:</div>", unsafe_allow_html=True)
        fu_col1, fu_col2, fu_col3 = st.columns(3)
        with fu_col1:
            if st.button("🔍 Which district has the highest risk?", key="fu1", use_container_width=True):
                st.session_state["ai_input_text"] = "Which districts have the highest retention risk?"
                st.rerun()
        with fu_col2:
            if st.button("📊 Show attendance trend over time", key="fu2", use_container_width=True):
                st.session_state["ai_input_text"] = "Show attendance trend over time"
                st.rerun()
        with fu_col3:
            if st.button("⚠️ Which schools have high proxy attendance?", key="fu3", use_container_width=True):
                st.session_state["ai_input_text"] = "Which schools have high proxy attendance?"
                st.rerun()

    st.markdown("<hr style='border-color: rgba(255,255,255,0.08); margin-top:30px;'/>", unsafe_allow_html=True)

# ============================================================
# 8. EXECUTIVE COMMAND CENTER
# ============================================================

# KPI Calculations
tot_schools = len(filtered_df)
tot_students = filtered_df["total_enrolled_students"].sum()
avg_attendance = filtered_df["average_attendance_rate"].mean()
avg_score = filtered_df["average_test_score"].mean()
avg_infra = filtered_df["average_facility_count"].mean()
avg_risk = filtered_df["retention_risk_indicator"].mean()

if avg_risk <= 20.0:
    risk_color = "#34d399"; risk_label = "Low Risk"
elif avg_risk <= 25.0:
    risk_color = "#fbbf24"; risk_label = "Moderate Risk"
elif avg_risk <= 30.0:
    risk_color = "#f97316"; risk_label = "High Risk"
else:
    risk_color = "#f43f5e"; risk_label = "Critical Risk"

# 6 Compact Executive KPI Cards
k1, k2, k3, k4, k5, k6 = st.columns(6)

with k1:
    st.markdown(f"""<div class="kpi-card"><div class="kpi-header"><span class="kpi-label">Schools</span><span class="kpi-icon">🏫</span></div><div class="kpi-value">{tot_schools:,}</div><div class="kpi-subtext">Monitored Scope</div></div>""", unsafe_allow_html=True)
with k2:
    st.markdown(f"""<div class="kpi-card"><div class="kpi-header"><span class="kpi-label">Enrollment</span><span class="kpi-icon">👨‍🎓</span></div><div class="kpi-value">{tot_students/1000:.1f}k</div><div class="kpi-subtext">Active Students</div></div>""", unsafe_allow_html=True)
with k3:
    st.markdown(f"""<div class="kpi-card"><div class="kpi-header"><span class="kpi-label">Attendance</span><span class="kpi-icon">📊</span></div><div class="kpi-value" style="color:#38bdf8;">{avg_attendance:.1f}%</div><div class="kpi-subtext">Avg Presence</div></div>""", unsafe_allow_html=True)
with k4:
    st.markdown(f"""<div class="kpi-card"><div class="kpi-header"><span class="kpi-label">Test Index</span><span class="kpi-icon">📝</span></div><div class="kpi-value" style="color:#a78bfa;">{avg_score:.1f}%</div><div class="kpi-subtext">Converted Avg</div></div>""", unsafe_allow_html=True)
with k5:
    st.markdown(f"""<div class="kpi-card"><div class="kpi-header"><span class="kpi-label">Infra Score</span><span class="kpi-icon">🏛️</span></div><div class="kpi-value" style="color:#34d399;">{avg_infra:.2f}<span style="font-size:13px;color:#64748b;">/5</span></div><div class="kpi-subtext">Facility Index</div></div>""", unsafe_allow_html=True)
with k6:
    st.markdown(f"""<div class="kpi-card" style="border-color:{risk_color}40;" title="Composite analytical indicator — not a measured dropout probability."><div class="kpi-header"><span class="kpi-label">Risk Indicator</span><span class="kpi-icon">🛡️</span></div><div class="kpi-value" style="color:{risk_color};">{avg_risk:.1f}</div><div class="kpi-subtext" style="color:{risk_color}; font-weight:600;">● {risk_label}</div></div>""", unsafe_allow_html=True)

st.markdown("<div style='font-size:11px; color:#64748b; font-style:italic; margin-top:4px; margin-bottom:15px;'>* Retention Risk Indicator is a composite analytical index (0-100) — not a measured student dropout probability.</div>", unsafe_allow_html=True)

# 7. MAIN INTERACTIVE DASHBOARD TABS
tab1, tab2, tab3, tab4, tab5, tab6 = st.tabs([
    "🏛️ Executive Command Center",
    "🎓 Academic & Attendance",
    "🛠️ Infrastructure & Welfare",
    "🏫 School 360° Inspector",
    "🔮 Policy Impact Simulator",
    "🛡️ Data Rescue & Audit"
])

# ------------------------------------------------------------
# TAB 1: EXECUTIVE COMMAND CENTER
# ------------------------------------------------------------
with tab1:
    col_left, col_right = st.columns([1.1, 0.9])

    with col_left:
        st.markdown(
            """
            <div class="glass-panel">
                <div class="panel-title">📍 District Retention Risk Benchmark</div>
                <div class="panel-subtitle">Comparative assessment of average attendance vs. retention risk across districts</div>
            """,
            unsafe_allow_html=True
        )

        dist_summary = filtered_df.groupby("district").agg(
            avg_att=("average_attendance_rate", "mean"),
            avg_risk=("retention_risk_indicator", "mean"),
            tot_schools=("school_id", "count"),
            tot_students=("total_enrolled_students", "sum")
        ).reset_index()

        fig_dist = px.scatter(
            dist_summary,
            x="avg_att",
            y="avg_risk",
            size="tot_students",
            color="avg_risk",
            text="district",
            color_continuous_scale=["#34d399", "#fbbf24", "#f43f5e"],
            labels={"avg_att": "Average Attendance (%)", "avg_risk": "Risk Indicator"}
        )
        fig_dist.update_traces(textposition="top center", marker=dict(line=dict(width=1.5, color="rgba(255,255,255,0.5)")))
        fig_dist.update_layout(**PLOTLY_LAYOUT)
        fig_dist.update_layout(height=380, coloraxis_showscale=False)
        st.plotly_chart(fig_dist, use_container_width=True)
        st.markdown("</div>", unsafe_allow_html=True)

    with col_right:
        st.markdown(
            """
            <div class="glass-panel">
                <div class="panel-title">📊 Analytical Risk Band Distribution</div>
                <div class="panel-subtitle">Categorization of schools across 4 analytical risk bands</div>
            """,
            unsafe_allow_html=True
        )

        # Risk Band Assignment
        def get_risk_band(r):
            if r <= 20.0: return "Low (0–20)"
            elif r <= 25.0: return "Moderate (20–25)"
            elif r <= 30.0: return "High (25–30)"
            else: return "Critical (30+)"

        rb_df = filtered_df.copy()
        rb_df["Risk_Band"] = rb_df["retention_risk_indicator"].apply(get_risk_band)

        band_summary = rb_df.groupby("Risk_Band").agg(
            School_Count=("school_id", "count"),
            Avg_Attendance=("average_attendance_rate", "mean"),
            Avg_Test_Score=("average_test_score", "mean")
        ).reindex(["Low (0–20)", "Moderate (20–25)", "High (25–30)", "Critical (30+)"]).fillna(0).reset_index()

        band_summary["Percentage"] = (band_summary["School_Count"] / len(filtered_df)) * 100

        fig_band = px.bar(
            band_summary,
            x="Risk_Band",
            y="School_Count",
            text="School_Count",
            color="Risk_Band",
            color_discrete_map={"Low (0–20)": "#34d399", "Moderate (20–25)": "#fbbf24", "High (25–30)": "#f97316", "Critical (30+)": "#f43f5e"}
        )
        fig_band.update_traces(textposition="outside")
        fig_band.update_layout(**PLOTLY_LAYOUT)
        fig_band.update_layout(height=380, showlegend=False, yaxis_title="Number of Schools")
        st.plotly_chart(fig_band, use_container_width=True)
        st.markdown("</div>", unsafe_allow_html=True)

    # FULL WIDTH PRIORITY SCHOOLS TABLE
    st.markdown(
        """
        <div class="glass-panel">
            <div class="panel-title">🚨 Priority Schools Intervention Matrix</div>
            <div class="panel-subtitle">Sortable school matrix displaying key metrics and primary risk driver identification</div>
        """,
        unsafe_allow_html=True
    )

    # Calculate Primary Risk Driver per school
    p_df = filtered_df.copy()
    def get_primary_driver(row):
        drivers = {
            "Attendance": row["attendance_risk"],
            "Proxy Attendance": row["proxy_risk"],
            "Academic Score": row["score_risk"],
            "Infrastructure": row["infrastructure_risk"]
        }
        return max(drivers, key=drivers.get)

    p_df["Primary_Risk_Driver"] = p_df.apply(get_primary_driver, axis=1)

    priority_table = p_df.sort_values("retention_risk_indicator", ascending=False)[
        ["school_id", "school_name", "district", "average_attendance_rate", "average_test_score", "average_facility_count", "proxy_attendance_rate", "retention_risk_indicator", "Primary_Risk_Driver"]
    ]

    st.dataframe(
        priority_table,
        column_config={
            "school_id": "ID",
            "school_name": st.column_config.TextColumn("School Name", width="medium"),
            "district": "District",
            "average_attendance_rate": st.column_config.NumberColumn("Attendance %", format="%.1f%%"),
            "average_test_score": st.column_config.NumberColumn("Academic %", format="%.1f%%"),
            "average_facility_count": st.column_config.NumberColumn("Infra (/5)", format="%.1f"),
            "proxy_attendance_rate": st.column_config.NumberColumn("Proxy %", format="%.1f%%"),
            "retention_risk_indicator": st.column_config.NumberColumn("Risk Indicator", format="%.2f"),
            "Primary_Risk_Driver": st.column_config.TextColumn("Primary Risk Driver", width="medium")
        },
        use_container_width=True,
        hide_index=True
    )
    st.markdown("</div>", unsafe_allow_html=True)

    # ADVANCED DATA-DERIVED INSIGHTS SECTION (8 INSIGHTS A-H)
    st.markdown("<div style='font-size:16px; font-weight:750; color:#f1f5f9; margin-top:20px; margin-bottom:12px;'>💡 Advanced Data-Derived Insights</div>", unsafe_allow_html=True)
    
    # Calculate Insights A through H
    top_risk_d = filtered_df.groupby("district")["retention_risk_indicator"].mean().idxmax()
    top_risk_d_val = filtered_df.groupby("district")["retention_risk_indicator"].mean().max()

    low_att_d = filtered_df.groupby("district")["average_attendance_rate"].mean().idxmin()
    low_att_d_val = filtered_df.groupby("district")["average_attendance_rate"].mean().min()

    low_score_d = filtered_df.groupby("district")["average_test_score"].mean().idxmin()
    low_score_d_val = filtered_df.groupby("district")["average_test_score"].mean().min()

    low_infra_d = filtered_df.groupby("district")["average_facility_count"].mean().idxmin()
    low_infra_d_val = filtered_df.groupby("district")["average_facility_count"].mean().min()

    top_proxy_d = filtered_df.groupby("district")["proxy_attendance_rate"].mean().idxmax()
    top_proxy_d_val = filtered_df.groupby("district")["proxy_attendance_rate"].mean().max()

    # Electricity Diff
    e_yes_score = filtered_df[filtered_df["electricity_available"] >= 100]["average_test_score"].mean()
    e_no_score = filtered_df[filtered_df["electricity_available"] < 100]["average_test_score"].mean()
    e_diff = e_yes_score - e_no_score

    # Correlation
    r_att_score = filtered_df["average_attendance_rate"].corr(filtered_df["average_test_score"])

    # Multi-risk count
    multi_risk_cnt = len(filtered_df[(filtered_df["attendance_risk"] > 20) & (filtered_df["infrastructure_risk"] > 40)])

    ins_c1, ins_c2 = st.columns(2)
    with ins_c1:
        st.markdown(f"""<div style="background:rgba(30,41,59,0.6); border:1px solid rgba(255,255,255,0.08); padding:14px; border-radius:12px; margin-bottom:10px; font-size:13px; color:#e2e8f0;">📍 <strong>Highest Risk District:</strong> <strong>{top_risk_d}</strong> records the highest average retention risk index at <strong>{top_risk_d_val:.2f}</strong>.</div>""", unsafe_allow_html=True)
        st.markdown(f"""<div style="background:rgba(30,41,59,0.6); border:1px solid rgba(255,255,255,0.08); padding:14px; border-radius:12px; margin-bottom:10px; font-size:13px; color:#e2e8f0;">📊 <strong>Lowest Attendance District:</strong> <strong>{low_att_d}</strong> averages the lowest student attendance at <strong>{low_att_d_val:.1f}%</strong>.</div>""", unsafe_allow_html=True)
        st.markdown(f"""<div style="background:rgba(30,41,59,0.6); border:1px solid rgba(255,255,255,0.08); padding:14px; border-radius:12px; margin-bottom:10px; font-size:13px; color:#e2e8f0;">📝 <strong>Lowest Academic Score District:</strong> <strong>{low_score_d}</strong> records the lowest converted test average at <strong>{low_score_d_val:.1f}%</strong>.</div>""", unsafe_allow_html=True)
