with tab4:
    st.markdown("### 🔍 Individual School 360° Diagnostic Scorecard")

    school_list = sorted(filtered_df["school_name"].unique())
    
    st.markdown("<div style='font-size:12px; font-weight:700; color:#94a3b8; margin-bottom:6px;'>⚡ QUICK INSPECTION BUTTONS (TOP HIGH-RISK SCHOOLS):</div>", unsafe_allow_html=True)
    top_5_schools = filtered_df.sort_values("retention_risk_indicator", ascending=False).head(5)["school_name"].tolist()
    
    s_btn_cols = st.columns(5)
    for idx, s_name in enumerate(top_5_schools):
        with s_btn_cols[idx]:
            short_name = s_name.replace("Govt. ", "").replace("Senior Secondary ", "Sr. Sec. ")
            if st.button(f"🏫 {short_name[:18]}...", key=f"s_quick_{idx}", use_container_width=True):
                st.session_state["selected_school_idx"] = school_list.index(s_name) if s_name in school_list else 0
                st.rerun()

    def_idx = st.session_state.get("selected_school_idx", 0)
    if def_idx >= len(school_list): def_idx = 0

    selected_school_name = st.selectbox("Select School for Inspection", school_list, index=def_idx)
    school_row = filtered_df[filtered_df["school_name"] == selected_school_name].iloc[0]

    # Component Risk Breakdown
    r_att_comp = school_row["attendance_risk"]
    r_proxy_comp = school_row["proxy_risk"]
    r_score_comp = school_row["score_risk"]
    r_infra_comp = school_row["infrastructure_risk"]
    tot_risk_comp = school_row["retention_risk_indicator"]

    risk_dict = {"Attendance Risk": r_att_comp, "Proxy Attendance Risk": r_proxy_comp, "Academic Risk": r_score_comp, "Infrastructure Risk": r_infra_comp}
    primary_driver = max(risk_dict, key=risk_dict.get)
    primary_driver_val = risk_dict[primary_driver]

    st.markdown("<div style='font-size:13px; font-weight:700; color:#e2e8f0; margin-bottom:8px;'>📊 4-Pillar Component Scorecard</div>", unsafe_allow_html=True)
    c_rb1, c_rb2, c_rb3, c_rb4, c_rb5 = st.columns(5)
    with c_rb1: st.markdown(f"""<div style='background:rgba(30,41,59,0.8); border:1px solid rgba(255,255,255,0.08); padding:12px; border-radius:12px; text-align:center;'><div style='font-size:11px; color:#94a3b8;'>ATTENDANCE RISK</div><div style='font-size:22px; font-weight:800; color:#38bdf8;'>{r_att_comp:.1f}</div></div>""", unsafe_allow_html=True)
    with c_rb2: st.markdown(f"""<div style='background:rgba(30,41,59,0.8); border:1px solid rgba(255,255,255,0.08); padding:12px; border-radius:12px; text-align:center;'><div style='font-size:11px; color:#94a3b8;'>PROXY RISK</div><div style='font-size:22px; font-weight:800; color:#fbbf24;'>{r_proxy_comp:.1f}</div></div>""", unsafe_allow_html=True)
    with c_rb3: st.markdown(f"""<div style='background:rgba(30,41,59,0.8); border:1px solid rgba(255,255,255,0.08); padding:12px; border-radius:12px; text-align:center;'><div style='font-size:11px; color:#94a3b8;'>ACADEMIC RISK</div><div style='font-size:22px; font-weight:800; color:#a78bfa;'>{r_score_comp:.1f}</div></div>""", unsafe_allow_html=True)
    with c_rb4: st.markdown(f"""<div style='background:rgba(30,41,59,0.8); border:1px solid rgba(255,255,255,0.08); padding:12px; border-radius:12px; text-align:center;'><div style='font-size:11px; color:#94a3b8;'>INFRA RISK</div><div style='font-size:22px; font-weight:800; color:#ef4444;'>{r_infra_comp:.1f}</div></div>""", unsafe_allow_html=True)
    with c_rb5: st.markdown(f"""<div style='background:rgba(15,23,42,0.9); border:1px solid #8b5cf6; padding:12px; border-radius:12px; text-align:center;'><div style='font-size:11px; color:#c084fc; font-weight:700;'>TOTAL RISK INDEX</div><div style='font-size:22px; font-weight:800; color:#ffffff;'>{tot_risk_comp:.2f}</div></div>""", unsafe_allow_html=True)

    # Primary Driver Chip
    st.markdown(f"""<div style="background:rgba(244,63,94,0.15); border:1px solid rgba(244,63,94,0.3); border-radius:12px; padding:12px 18px; margin-top:12px; margin-bottom:18px;"><span style="font-weight:700; color:#f43f5e;">🔴 Primary Risk Driver:</span> <span style="color:#f1f5f9;"><strong>{primary_driver}</strong> ({primary_driver_val:.1f}) is the largest component of this school's overall risk index ({tot_risk_comp:.2f}).</span></div>""", unsafe_allow_html=True)

    col_s1, col_s2 = st.columns([1, 1.2])

    with col_s1:
        categories = ["Attendance Rate", "Test Performance", "Infra Coverage", "MDM Paid %", "Retention Safety"]
        values = [school_row["average_attendance_rate"], school_row["average_test_score"], (school_row["average_facility_count"]/5.0)*100, school_row["paid_percentage"], max(0, 100-(school_row["retention_risk_indicator"]*2.5))]
        values += values[:1]; categories_closed = categories + [categories[0]]

        fig_radar = gg.Figure()
        fig_radar.add_trace(gg.Scatterpolar(r=values, theta=categories_closed, fill='toself', fillcolor='rgba(139,92,246,0.35)', line=dict(color='#c084fc', width=2)))
        fig_radar.update_layout(polar=dict(radialaxis=dict(visible=True, range=[0,100], gridcolor="rgba(255,255,255,0.1)"), angularaxis=dict(gridcolor="rgba(255,255,255,0.1)", tickfont=dict(color="#e2e8f0", size=11)), bgcolor="rgba(0,0,0,0)"), paper_bgcolor="rgba(0,0,0,0)", plot_bgcolor="rgba(0,0,0,0)", showlegend=False, height=360, margin=dict(l=30,r=30,t=30,b=30))
        st.plotly_chart(fig_radar, use_container_width=True)

    with col_s2:
        # Evidence-Based Flag Observations & Metric-Tied Recommendations
        obs_1 = f"Average student presence recorded at <strong>{school_row['average_attendance_rate']:.1f}%</strong>."
        obs_2 = f"Proxy attendance marking flagged at <strong>{school_row['proxy_attendance_rate']:.1f}%</strong> of reporting days."
        obs_3 = f"Average test performance benchmark stands at <strong>{school_row['average_test_score']:.1f}%</strong>."
        obs_4 = f"Core facilities availability index rated at <strong>{school_row['average_facility_count']:.2f}/5.0</strong>."

        rec_toilet = "⚠️ Priority sanitation repair required due to low toilet functionality." if school_row["functional_toilet_available"] < 80 else "✅ Sanitation infrastructure operating within normal parameters."
        rec_proxy = "⚠️ Audit proxy attendance records with local inspection team." if school_row["proxy_attendance_rate"] > 4.0 else "✅ Attendance reporting verified within expected variance."
        rec_mdm = "⚠️ Escalate pending MDM vendor payments to prevent supply disruption." if school_row["paid_percentage"] < 50 else "✅ No elevated payment-clearance alert under configured monitoring threshold."

        st.markdown(
            f"""
            <div class="memo-card">
                <div class="memo-header">
                    <span>📋 Diagnostic Observations & Recommendations</span>
                </div>
                <div style="font-size:13px; color:#e2e8f0; line-height:1.6;">
                    <strong>School Identity:</strong> {school_row['school_name']} ({school_row['school_id']})<br/>
                    <strong>Location:</strong> District {school_row['district']} • Block {school_row['block']}<br/>
                    <hr style="border-color: rgba(139, 92, 246, 0.2); margin: 8px 0;"/>
                    <strong>Why this school is being flagged:</strong>
                    <ul style="margin-top:4px; padding-left:18px;">
                        <li>{obs_1}</li>
                        <li>{obs_2}</li>
                        <li>{obs_3}</li>
                        <li>{obs_4}</li>
                    </ul>
                    <hr style="border-color: rgba(139, 92, 246, 0.2); margin: 8px 0;"/>
                    <strong>Recommended Actions:</strong><br/>
                    <div style="color:#a78bfa; margin-top:4px;">
                        • {rec_toilet}<br/>
                        • {rec_proxy}<br/>
                        • {rec_mdm}
                    </div>
                </div>
            </div>
            """,
            unsafe_allow_html=True
        )

