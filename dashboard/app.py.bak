            st.session_state["sim_att_val"] = 10.0; st.session_state["sim_score_val"] = 10.0; st.session_state["sim_infra_val"] = 1.5; st.session_state["sim_proxy_val"] = 3.0; st.rerun()
    with p_preset_col4:
        if st.button("🔄 Reset Sliders", key="ps_reset", use_container_width=True):
            st.session_state["sim_att_val"] = 0.0; st.session_state["sim_score_val"] = 0.0; st.session_state["sim_infra_val"] = 0.0; st.session_state["sim_proxy_val"] = 0.0; st.rerun()

    ps1, ps2, ps3, ps4 = st.columns(4)
    with ps1: sim_att_boost = st.slider("Attendance Campaign (+%)", 0.0, 15.0, st.session_state["sim_att_val"], 0.5)
    with ps2: sim_score_boost = st.slider("Academic Remedial Support (+%)", 0.0, 15.0, st.session_state["sim_score_val"], 0.5)
    with ps3: sim_infra_boost = st.slider("Infra Upgrade (+Facility Count)", 0.0, 2.0, st.session_state["sim_infra_val"], 0.1)
    with ps4: sim_proxy_reduction = st.slider("Proxy Attendance Reduction (-%)", 0.0, 5.0, st.session_state["sim_proxy_val"], 0.5)

    sim_df = filtered_df.copy()
    sim_df["sim_att_rate"] = (sim_df["average_attendance_rate"] + sim_att_boost).clip(upper=100)
    sim_df["sim_test_score"] = (sim_df["average_test_score"] + sim_score_boost).clip(upper=100)
    sim_df["sim_facility_count"] = (sim_df["average_facility_count"] + sim_infra_boost).clip(upper=5.0)
    sim_df["sim_proxy_rate"] = (sim_df["proxy_attendance_rate"] - sim_proxy_reduction).clip(lower=0.0)

    sim_df["sim_att_risk"] = 100 - sim_df["sim_att_rate"]
    sim_df["sim_proxy_risk"] = sim_df["sim_proxy_rate"]
    sim_df["sim_score_risk"] = 100 - sim_df["sim_test_score"]
    sim_df["sim_infra_risk"] = (5.0 - sim_df["sim_facility_count"]) / 5.0 * 100

    sim_df["projected_risk"] = sim_df[["sim_att_risk", "sim_proxy_risk", "sim_score_risk", "sim_infra_risk"]].mean(axis=1)

    baseline_risk = filtered_df["retention_risk_indicator"].mean()
    projected_risk = sim_df["projected_risk"].mean()

    risk_delta = baseline_risk - projected_risk
    risk_drop_pct = (risk_delta / baseline_risk) * 100 if baseline_risk > 0 else 0

    col_res1, col_res2 = st.columns([1, 1.5])

    with col_res1:
        st.markdown(
            f"""
            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(16, 185, 129, 0.3); padding: 24px; border-radius: 16px; text-align: center;">
                <div style="font-size: 12px; color: #94a3b8; font-weight: 700; text-transform: uppercase;">BASELINE RISK INDEX</div>
                <div style="font-size: 32px; font-weight: 800; color: #f43f5e; margin: 4px 0;">{baseline_risk:.2f}</div>
                <div style="font-size: 15px; color: #94a3b8; margin: 8px 0;">⬇️ Index Reduction (-{risk_delta:.2f} points)</div>
                <div style="font-size: 12px; color: #94a3b8; font-weight: 700; text-transform: uppercase;">PROJECTED RISK INDEX</div>
                <div style="font-size: 38px; font-weight: 800; color: #34d399; margin: 4px 0;">{projected_risk:.2f}</div>
                <div style="font-size: 13px; color: #34d399; font-weight: 700; margin-top: 8px;">
                    🎉 {risk_drop_pct:.1f}% Projected Risk-Index Reduction
                </div>
            </div>
            """,
            unsafe_allow_html=True
        )

    with col_res2:
        dist_sim = sim_df.groupby("district").agg(Baseline=("retention_risk_indicator", "mean"), Projected=("projected_risk", "mean")).reset_index()
        dist_sim_melt = dist_sim.melt(id_vars=["district"], var_name="Scenario", value_name="Risk Index")

        fig_sim = px.bar(dist_sim_melt, x="district", y="Risk Index", color="Scenario", barmode="group", color_discrete_map={"Baseline": "#f43f5e", "Projected": "#34d399"})
        fig_sim.update_layout(**PLOTLY_LAYOUT)
        fig_sim.update_layout(height=340, title="District Risk Index: Baseline vs. Projected Policy Outcome")
        st.plotly_chart(fig_sim, use_container_width=True)

    with st.expander("📐 Policy Simulator Calculation Methodology & Formulas"):
        st.markdown(
            """
            **Scenario Assumptions & Risk Calculation Formulas:**
            - **Projected Attendance Risk** $= 100 - \text{Projected Attendance Rate}$
            - **Projected Proxy Risk** $= \text{Projected Proxy Attendance Rate}$
            - **Projected Academic Risk** $= 100 - \text{Projected Test Score}$
            - **Projected Infrastructure Risk** $= \frac{5.0 - \text{Projected Facility Count}}{5.0} \times 100$
            - **Projected Retention Risk Index** $= \text{Mean of four component risks}$

            *Note: Scenario planning outputs simulate hypothetical improvements under linear assumptions and should not be interpreted as causal forecasts.*
            """
        )

