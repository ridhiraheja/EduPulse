    selected_block = st.selectbox("Block", ["All Blocks"] + avail_blocks, key="filter_block")

    school_types = sorted(df_analytics["school_type"].dropna().unique())
    selected_type = st.selectbox("School Level", ["All Levels"] + school_types, key="filter_type")

    mediums = sorted(df_analytics["medium"].dropna().unique())
    selected_medium = st.selectbox("Instruction Medium", ["All Mediums"] + mediums, key="filter_medium")

    risk_bands = ["All Risk Bands", "Low (0–20)", "Moderate (20–25)", "High (25–30)", "Critical (30+)"]
    selected_risk_band = st.selectbox("Analytical Risk Band", risk_bands, key="filter_risk_band")

    st.button("🔄 Reset Filters", on_click=reset_filters_callback, use_container_width=True)

    # Filter Application Logic
    filtered_df = df_analytics.copy()

    if selected_district != "All Districts":
        filtered_df = filtered_df[filtered_df["district"] == selected_district]
    if selected_block != "All Blocks":
        filtered_df = filtered_df[filtered_df["block"] == selected_block]
    if selected_type != "All Levels":
        filtered_df = filtered_df[filtered_df["school_type"] == selected_type]
    if selected_medium != "All Mediums":
        filtered_df = filtered_df[filtered_df["medium"] == selected_medium]

    if selected_risk_band == "Low (0–20)":
        filtered_df = filtered_df[filtered_df["retention_risk_indicator"] <= 20.0]
    elif selected_risk_band == "Moderate (20–25)":
        filtered_df = filtered_df[(filtered_df["retention_risk_indicator"] > 20.0) & (filtered_df["retention_risk_indicator"] <= 25.0)]
    elif selected_risk_band == "High (25–30)":
        filtered_df = filtered_df[(filtered_df["retention_risk_indicator"] > 25.0) & (filtered_df["retention_risk_indicator"] <= 30.0)]
    elif selected_risk_band == "Critical (30+)":
        filtered_df = filtered_df[filtered_df["retention_risk_indicator"] > 30.0]

    st.markdown("<hr style='border-color: rgba(255,255,255,0.08);'/>", unsafe_allow_html=True)

    st.markdown(
